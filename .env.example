# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do arquivo .env.

# Obrigatória para usar o agente: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (valores padrão mostrados)
# Modelos antigos (ex.: gemini-2.5-*) não estão disponíveis para contas novas.
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: modelos Gemini mais novos ignoram a temperatura.
# GEMINI_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# Máximo de chamadas ao modelo por requisição (1-20)
AGENT_MAX_ITERATIONS=5
# Mensagens recentes da conversa enviadas ao modelo (>= 2 x AGENT_MAX_ITERATIONS + 2)
MAX_HISTORY_MESSAGES=30

DEFAULT_TIMEZONE=America/Sao_Paulo
REPORTS_DIR=reports
MAX_MESSAGE_LENGTH=2000
LOG_LEVEL=INFO

# Memória persistente (SQLite) e retenção das conversas
DATABASE_PATH=data/atlas.db
CONVERSATION_TTL_HOURS=72

# Segurança
# Token de acesso à API (mínimo 16 caracteres). Vazio = API aberta (só para uso local).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_API_TOKEN=
RATE_LIMIT_PER_MINUTE=20
GLOBAL_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=64000
